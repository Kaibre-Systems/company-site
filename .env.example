# Contact form delivery.
#
# Without RESEND_API_KEY the form still works: /api/contact returns
# "not_configured" and the client hands the message to the visitor's mail app,
# with the address shown in plain text as a final fallback. Nothing breaks —
# it just does not send server-side.
#
# Copy to `.env.local` for development, and set the same values in Vercel
# (Project → Settings → Environment Variables) for production.

# https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries land. Defaults to the address published on the site.
CONTACT_TO_EMAIL=systemskaibre@gmail.com

# Must be on a domain verified in Resend. Until kaibresystems.com is verified,
# Resend's shared sender works for testing:
#   CONTACT_FROM_EMAIL="Kaibre site <onboarding@resend.dev>"
CONTACT_FROM_EMAIL=
